<?xml version='1.0' ?>
<BuildGraph xmlns="http://www.epicgames.com/BuildGraph" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.epicgames.com/BuildGraph ../../Schema.xsd" >

	<!-- =====================================================================
	     ReaperPipeline.xml
	     =====================================================================
	     OFF-AGENT orphan reaper. Runs reap-orphans.ps1 on the idle SINGLE-WRITER
	     SyncPool (the hydrator) on a schedule, to collect per-job clone volumes
	     and their Perforce clients that the ON-AGENT teardown never ran for -
	     i.e. after a HARD SPOT RECLAIM killed the build agent before either the
	     UE_HORDE_CLEANUP lease hook or the "Cleanup Clone" node could run. A
	     leaked clone volume PINS its parent snapshot and eventually breaks
	     snapshot rotation; a leaked p4 client accumulates as dead have-list
	     metadata. README appendix section 4 promised this; this ships it.

	     WHY THE SyncPool: it is min=max=1 Windows, already has ONTAP REST
	     reachability + OntapSan.psm1 + p4 on the agent AMI, and is OUT of the hot
	     build path, so a periodic sweep is free and cannot contend with a build.

	     SAFETY: reap-orphans.ps1 deletes a client ONLY when name-gate AND
	     backing-clone-gone AND Horde-job-not-live ALL pass; ANY uncertainty keeps
	     the object. Default is a DRY RUN; -Execute (via the Execute Option below)
	     turns on deletion. Operators should run it dry first.

	     COUPLING to config/horde/globals.json.tpl (must stay in sync):
	       * <Agent Name="SyncAgent"> matches the agentTypes key "SyncAgent"
	         (SyncPool). Same pool as HydratePipeline.xml.
	       * <Node Name="Reap Orphans"> matches -Target=Reap Orphans.
	       * Every <Option> without a DefaultValue must be injected as a -set:
	         argument there, or the job fails at graph-parse time.
	     ===================================================================== -->

	<!-- Perforce -->
	<Option Name="P4Port" DefaultValue="perforce:1666" Description="Perforce server address" />
	<Option Name="P4User" DefaultValue="perforce" Description="Perforce username" />
	<Option Name="P4CredentialsSecret" DefaultValue="" Description="Optional Secrets Manager secret (JSON {username,password}) to mint a ticket. Empty = rely on an existing ticket." />
	<Option Name="StreamSafe" DefaultValue="" Description="Stream sanitized to [a-z0-9_] (Terraform local fsxn_client_stream_safe). Scopes the sweep to this stream's hordeclone_ clients and recovers each client's backing clone-volume name." />

	<!-- ONTAP / SAN -->
	<Option Name="SvmName" DefaultValue="fsx" Description="Storage Virtual Machine name" />
	<Option Name="LunName" DefaultValue="workspace" Description="LUN leaf inside each clone volume (/vol/&lt;clone&gt;/&lt;LunName&gt;). MUST match the build pipeline's LunName (Terraform local.fsxn_lun_name) so PASS-2 unmaps the right path." />
	<Option Name="FsxAdminIp" DefaultValue="" Description="FSx ONTAP management endpoint (DNS name or IP) for the REST API" />
	<Option Name="OntapUser" DefaultValue="fsxadmin" Description="ONTAP username" />
	<Option Name="OntapPasswordSecretName" DefaultValue="" Description="AWS Secrets Manager secret name for the ONTAP password" />
	<Option Name="AwsRegion" DefaultValue="us-east-1" Description="AWS region for the secret" />

	<!-- Horde job-liveness gate. Base URL of the Horde server, e.g.
	     https://horde.example.com. If empty/unreachable the reaper cannot prove a
	     job is done and deletes NOTHING (fail-safe). -->
	<Option Name="HordeServerUrl" DefaultValue="" Description="Base URL of the Horde server for the job-liveness gate (e.g. https://horde.example.com). Empty = reaper deletes nothing." />

	<!-- Deletion switch. Default false = DRY RUN (logs what it WOULD reap).
	     Set true to actually delete. Uses the confirmed equality-If form. -->
	<Option Name="Execute" DefaultValue="false" Description="Set true to actually delete orphans. Default false = dry run (log only)." />

	<Agent Name="SyncAgent" Type="AnyAgent">
		<!-- Node name MUST be "Reap Orphans" to match globals.json
		     -Target=Reap Orphans. -->
		<Node Name="Reap Orphans">
			<!-- Mint a P4 ticket first: the reaper's `p4 clients`/`p4 client -d`
			     need auth on a fresh agent, exactly like the build node. -->
			<Spawn Exe="powershell.exe" Arguments="-NoProfile -ExecutionPolicy Bypass -File Build/p4-login.ps1 -P4Port &quot;$(P4Port)&quot; -P4User &quot;$(P4User)&quot; -P4CredentialsSecret &quot;$(P4CredentialsSecret)&quot; -AwsRegion &quot;$(AwsRegion)&quot;" />

			<!-- -Execute is appended only when Execute==true; otherwise the
			     reaper runs as a DRY RUN. Literal Property + equality-If, no C#
			     string expression. -->
			<Property Name="ExecuteArg" Value="" />
			<Property Name="ExecuteArg" Value="-Execute" If="'$(Execute)' == 'true'" />

			<Spawn Exe="powershell.exe" Arguments="-NoProfile -ExecutionPolicy Bypass -File Build/reap-orphans.ps1 -P4Port &quot;$(P4Port)&quot; -P4User &quot;$(P4User)&quot; -StreamSafe &quot;$(StreamSafe)&quot; -SvmName &quot;$(SvmName)&quot; -FsxAdminIp &quot;$(FsxAdminIp)&quot; -OntapUser &quot;$(OntapUser)&quot; -OntapPasswordSecretName &quot;$(OntapPasswordSecretName)&quot; -AwsRegion &quot;$(AwsRegion)&quot; -HordeServerUrl &quot;$(HordeServerUrl)&quot; -LunName &quot;$(LunName)&quot; $(ExecuteArg)" />
		</Node>
	</Agent>
</BuildGraph>
