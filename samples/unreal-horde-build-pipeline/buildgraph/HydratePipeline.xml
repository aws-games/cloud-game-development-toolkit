<?xml version='1.0' ?>
<BuildGraph xmlns="http://www.epicgames.com/BuildGraph" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.epicgames.com/BuildGraph ../../Schema.xsd" >

	<!-- =====================================================================
	     HydratePipeline.xml  (JT-19)
	     =====================================================================
	     Purpose: periodic hydration. Sync the latest changelist from the
	     Perforce stream onto the persistent SOURCE FSxN volume and take an
	     ONTAP snapshot of that volume. Runs on the Linux sync agent.

	     COUPLING to config/horde/globals.json.tpl (must stay in sync):
	       * <Agent Name="SyncAgent"> matches the agentTypes key "SyncAgent"
	         (type = SyncPool, condition OSFamily == 'Linux').
	       * <Node Name="Sync And Snapshot"> matches the "hydrate" template
	         argument -Target=Sync And Snapshot.
	       * globals.json passes -Script=Build/HydratePipeline.xml. That path
	         resolves against the depot STREAM ROOT once this buildgraph/ dir is
	         submitted to Perforce (Build/ maps to this buildgraph/ folder).
	         Confirming that path resolution is a Phase 6 live-validation item.
	     ===================================================================== -->

	<!-- Parameters that can be set from Horde -->
	<Option Name="Stream" DefaultValue="" Description="Perforce stream to sync from (e.g. //depot/main)" />
	<Option Name="P4Port" DefaultValue="perforce:1666" Description="Perforce server address" />
	<Option Name="P4User" DefaultValue="perforce" Description="Perforce username" />
	<!-- SyncDir points at the mounted SOURCE FSxN volume. The Linux sync agent
	     mounts the persistent source volume over NFSv3 at /mnt/p4-workspace via
	     /etc/fstab (see config/sync-agent.ansible.yml, ADR-002 NFS-only). -->
	<Option Name="SyncDir" DefaultValue="/mnt/p4-workspace" Description="Directory to sync files to; must be the mounted FSxN source volume path (NFS mount from sync-agent.ansible.yml)" />
	<Option Name="WorkspaceName" DefaultValue="SyncWorkspace" Description="Perforce workspace name (matches globals.json SyncWorkspace)" />

	<!-- ONTAP Snapshot Parameters -->
	<Option Name="SnapshotName" DefaultValue="" Description="Optional explicit snapshot name. If empty, a name is derived from the changelist ($(Change)) below." />
	<Option Name="FsxAdminIp" DefaultValue="" Description="FSx ONTAP management IP address" />
	<Option Name="OntapUser" DefaultValue="fsxadmin" Description="ONTAP username" />
	<Option Name="OntapPasswordSecretName" DefaultValue="" Description="AWS Secrets Manager secret name for the ONTAP password" />
	<Option Name="AwsRegion" DefaultValue="us-east-1" Description="AWS region for the secret" />
	<Option Name="VolumeName" DefaultValue="" Description="ONTAP source volume name to take the snapshot from" />

	<!-- Derive the effective snapshot name from BuildGraph's built-in $(Change) property.
	     $(Change) is a first-class BuildGraph property populated from the P4 changelist the
	     job runs at (P4Env.Changelist / uebp_CL); it uses $(...) syntax, NOT ${...}. The old
	     globals.json literal '-set:SnapshotName=hydrate-${Change}' never expanded because
	     BuildGraph does not interpolate ${...}. We compute the name here instead.
	       * If an explicit SnapshotName was passed, use it verbatim.
	       * Else if we have a real changelist (Change set and not '0'), use hydrate-<CL>.
	       * Else fall back to hydrate-job-<HordeJobId> so the name is always valid, unique,
	         and never a bare literal (UE_HORDE_JOBID is set by Horde on dispatched jobs). -->
	<EnvVar Name="UE_HORDE_JOBID" />
	<Property Name="EffectiveSnapshotName" Value="hydrate-job-$(UE_HORDE_JOBID)" />
	<Property Name="EffectiveSnapshotName" Value="hydrate-$(Change)" If="'$(Change)' != '' And '$(Change)' != '0'" />
	<Property Name="EffectiveSnapshotName" Value="$(SnapshotName)" If="'$(SnapshotName)' != ''" />

	<!-- SyncAgent maps to the SyncPool Linux agent (globals.json agentTypes key
	     "SyncAgent"). The Agent Type MUST equal a key in the stream's
	     agentTypes map (SyncAgent / BuildAgent) — Horde resolves the pool +
	     workspace from that key. Using Type="AnyAgent" (not a key in agentTypes)
	     makes Horde fail the Setup Build batch with error=UnknownAgentType and
	     skip the job (observed on job 6a958eff... change 12). The pool condition
	     (OSFamily == 'Linux') is enforced in globals.json under the resolved
	     SyncAgent -> sync-pool mapping. -->
	<Agent Name="SyncAgent" Type="SyncAgent">
		<!-- Node name MUST be "Sync And Snapshot" to match globals.json
		     -Target=Sync And Snapshot. (Do not rename to "Sync From Stream".) -->
		<Node Name="Sync And Snapshot">
			<!-- Sync from the Perforce stream onto the mounted source volume,
			     then create an ONTAP snapshot of VolumeName. -->
			<SyncAndSnapshot Stream="$(Stream)" P4Port="$(P4Port)" P4User="$(P4User)" SyncDir="$(SyncDir)" WorkspaceName="$(WorkspaceName)" SnapshotName="$(EffectiveSnapshotName)" FsxAdminIp="$(FsxAdminIp)" OntapUser="$(OntapUser)" OntapPasswordSecretName="$(OntapPasswordSecretName)" AwsRegion="$(AwsRegion)" VolumeName="$(VolumeName)" />
		</Node>
	</Agent>
</BuildGraph>
