<?xml version='1.0' ?>
<BuildGraph xmlns="http://www.epicgames.com/BuildGraph" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.epicgames.com/BuildGraph ../../Schema.xsd" >

	<!-- =====================================================================
	     BuildPipeline.xml
	     =====================================================================
	     Per-build pipeline: FlexClone the source volume's snapshot, present the
	     clone's LUN to this agent over iSCSI as real NTFS, transplant the
	     Perforce have-list, incremental-sync the delta, compile, then always
	     clean up. Runs entirely on one Windows build agent.

	     SINGLE-NODE COMPILE (Option 1 merge): BuildGraph runs each <Node> as its
	     own RunUAT -SingleNode process. A LUN mounted in one node's process does
	     NOT persist into another node's process, so a prior split of "Clone And
	     Mount" (node A) and "Compile" (node B) failed: W: mounted in A was gone
	     in B and p4 flush ran against an invalid working dir. Fix: the clone +
	     attach + mount now happens at the TOP of the Compile node, so a SINGLE
	     process does clone -> mount W: -> p4 flush -> p4 sync -> Build.bat.

	     COUPLING to config/horde/globals.json.tpl (must stay in sync):
	       * <Agent Name="BuildAgent"> matches the agentTypes key "BuildAgent".
	       * <Node Name="Compile"> matches the "build" template -Target=Compile.
	       * Every <Option> without a DefaultValue must be injected as a -set:
	         argument there, or the job fails at graph-parse time.
	     ===================================================================== -->

	<!-- FlexClone / ONTAP parameters -->
	<Option Name="SourceVolume" DefaultValue="" Description="Source ONTAP volume that holds the snapshot to clone from" />
	<Option Name="SnapshotName" DefaultValue="" Description="Snapshot to clone from (cl-{N}, produced by the hydrate pipeline)" />
	<Option Name="CloneVolumeName" DefaultValue="" Description="Name for the per-build FlexClone volume. ONTAP names reject hyphens - use build_{jobid}, lowercased." />
	<Option Name="LunName" DefaultValue="workspace" Description="LUN name inside the clone volume (same name as in the source volume)" />
	<Option Name="AgentIgroup" DefaultValue="" Description="iSCSI igroup that per-job clone LUNs are mapped to. Shared across build agents, which is safe: one clone = one job = one agent." />
	<Option Name="SvmName" DefaultValue="fsx" Description="Storage Virtual Machine name" />
	<Option Name="FsxAdminIp" DefaultValue="" Description="FSx ONTAP management endpoint (DNS name or IP) for the REST API" />
	<Option Name="OntapUser" DefaultValue="fsxadmin" Description="ONTAP username" />
	<Option Name="OntapPasswordSecretName" DefaultValue="" Description="AWS Secrets Manager secret name for the ONTAP password" />
	<Option Name="AwsRegion" DefaultValue="us-east-1" Description="AWS region for the secret" />

	<!-- iSCSI data path. Comma-separated portal addresses; the attach script
	     connects exactly ONE unless the MPIO feature is installed, because two
	     portals without MPIO make Windows enumerate one LUN as two disks. -->
	<Option Name="IscsiPortals" DefaultValue="" Description="Comma-separated SVM iSCSI portal addresses (Terraform output fsxn_iscsi_portals)" />
	<Option Name="CloneMountDrive" DefaultValue="W" Description="Drive letter for the per-build clone LUN (no colon)" />

	<!-- Perforce parameters (incremental sync into the attached clone) -->
	<Option Name="Stream" DefaultValue="" Description="Perforce stream to sync from (e.g. //depot/main)" />
	<Option Name="P4Port" DefaultValue="perforce:1666" Description="Perforce server address" />
	<Option Name="P4User" DefaultValue="perforce" Description="Perforce username" />
	<Option Name="P4PasswordSecret" DefaultValue="" Description="Optional Secrets Manager secret holding the P4 password. Used ONCE to mint a login ticket the later flush/sync reuse; empty = rely on an existing ticket." />
	<Option Name="WorkspaceName" DefaultValue="BuildWorkspace" Description="Perforce workspace name (matches globals.json BuildWorkspace)" />

	<!-- The changelist the cloned snapshot was synced to. REQUIRED for the
	     incremental sync to actually be incremental - see the p4 flush step.
	     Snapshots are named cl-{N}, so this is the {N} of $(SnapshotName), and
	     hydrate-source-lun.ps1 prints it. -->
	<Option Name="SnapshotChangelist" DefaultValue="" Description="Changelist the cloned snapshot was synced to (the N in cl-N)" />

	<!-- Unreal compile parameters -->
	<Option Name="UEProject" DefaultValue="" Description="Path to the .uproject relative to the attached clone (e.g. W:/MyGame/MyGame.uproject). Empty = engine-only build." />
	<Option Name="UETarget" DefaultValue="Editor" Description="Unreal build target to compile (e.g. Editor, Game, Server)" />
	<Option Name="UEPlatform" DefaultValue="Win64" Description="Target platform for the Unreal compile" />
	<Option Name="UEConfiguration" DefaultValue="Development" Description="Build configuration (Debug, Development, Shipping)" />
	<!-- Empty means UBA ON, which is the point of moving to iSCSI. Do not set
	     -NoUBA here: a build farm without a build accelerator is not the thing
	     being demonstrated, and any timing taken with UBA off is not comparable. -->
	<Option Name="ExtraUbtArgs" DefaultValue="" Description="Extra UnrealBuildTool arguments. Leave empty to keep UBA enabled." />

	<Agent Name="BuildAgent" Type="AnyAgent">

		<!-- Step 1+2 MERGED into ONE node. The Compile node now self-mounts W:.
		     Name MUST stay "Compile" to match globals.json -Target=Compile.
		     BuildGraph runs each node as its own RunUAT -SingleNode process, so
		     the clone LUN MUST be mounted in the SAME process that runs p4 flush
		     and Build.bat - hence the clone+attach+mount is the first action of
		     this node, not a separate "Clone And Mount" node. -->
		<Node Name="Compile">
			<!-- STEP 2.-1: mint a P4 login ticket. A fresh build agent has no
			     ticket, so the p4 flush/sync below (and the p4 client create in
			     create-build-client.ps1) would fail auth. The password is used
			     ONCE here to write a ticket to the default user-profile ticket
			     file; every later p4 spawn in this node reuses that ticket. Runs
			     FIRST because create-build-client.ps1 also talks to p4. -->
			<Spawn Exe="powershell.exe" Arguments="-NoProfile -ExecutionPolicy Bypass -File Build/p4-login.ps1 -P4Port &quot;$(P4Port)&quot; -P4User &quot;$(P4User)&quot; -P4PasswordSecret &quot;$(P4PasswordSecret)&quot; -AwsRegion &quot;$(AwsRegion)&quot;" />

			<!-- STEP 2.0: clone the snapshot, present its LUN over iSCSI, bring
			     it online as $(CloneMountDrive):. attach-clone-lun.ps1 registers
			     the teardown hook BEFORE creating anything, so a failure at any
			     point below is still cleaned up. This runs in THIS node's process
			     so W: is live for the flush + sync + compile that follow. -->
			<Spawn Exe="powershell.exe" Arguments="-NoProfile -ExecutionPolicy Bypass -File Build/attach-clone-lun.ps1 -SourceVolume &quot;$(SourceVolume)&quot; -SnapshotName &quot;$(SnapshotName)&quot; -CloneVolumeName &quot;$(CloneVolumeName)&quot; -LunName &quot;$(LunName)&quot; -AgentIgroup &quot;$(AgentIgroup)&quot; -SvmName &quot;$(SvmName)&quot; -FsxAdminIp &quot;$(FsxAdminIp)&quot; -OntapUser &quot;$(OntapUser)&quot; -OntapPasswordSecretName &quot;$(OntapPasswordSecretName)&quot; -AwsRegion &quot;$(AwsRegion)&quot; -IscsiPortals &quot;$(IscsiPortals)&quot; -MountDrive &quot;$(CloneMountDrive)&quot;" />

			<!-- STEP 2a-pre: create/refresh the per-build p4 client rooted on the
			     clone LUN. The prior split assumed a pre-existing client named
			     $(WorkspaceName), but no such client exists on the server (the
			     Horde-managed clients are named Horde+HOST+++...+BuildWorkspace
			     and rooted in the agent sandbox, NOT on W:). flush is
			     metadata-only and needs a client whose Root is the clone drive so
			     the have-list it stamps lines up with the files physically
			     present on W:. Invoked via -File so BuildGraph/cmd quoting cannot
			     corrupt the client spec. -->
			<Spawn Exe="powershell.exe" Arguments="-NoProfile -ExecutionPolicy Bypass -File Build/create-build-client.ps1 -P4Port &quot;$(P4Port)&quot; -P4User &quot;$(P4User)&quot; -WorkspaceName &quot;$(WorkspaceName)&quot; -Stream &quot;$(Stream)&quot; -MountDrive &quot;$(CloneMountDrive)&quot;" />

			<!-- STEP 2a: transplant the have-list. `p4 flush` (alias: sync -k)
			     updates the have-list WITHOUT transferring file content. It MUST
			     target the exact changelist the snapshot was taken at. -->
			<Spawn Exe="p4.exe" Arguments="-p $(P4Port) -u $(P4User) -c $(WorkspaceName) flush $(Stream)/...@$(SnapshotChangelist)" WorkingDir="$(CloneMountDrive):/" />

			<!-- STEP 2b: now the sync really is incremental - only the delta
			     between $(SnapshotChangelist) and head. -->
			<Spawn Exe="p4.exe" Arguments="-p $(P4Port) -u $(P4User) -c $(WorkspaceName) sync $(Stream)/..." WorkingDir="$(CloneMountDrive):/" />

			<!-- STEP 2b-clr: clear the read-only attribute across the clone.
			     Perforce syncs files with the "noallwrite" client option, which
			     stamps every synced file read-only. The snapshot preserves that,
			     so every clone LUN arrives with read-only Engine/Intermediate and
			     project files. UBT/UHT/VerseVM regenerate headers UNDER
			     Engine\Intermediate and $(UEProject)\Intermediate during the
			     build and must overwrite those pre-synced generated files; a
			     read-only target throws UnauthorizedAccessException (observed:
			     W:\Engine\Intermediate\...\VerseVMBytecode\VVMBytecodeOps.gen.h).
			     The clone is a throwaway per-build volume, so clearing read-only
			     drive-wide is safe and is the minimal fix. -->
			<Spawn Exe="cmd.exe" Arguments="/C attrib -R $(CloneMountDrive):\*.* /S /D" WorkingDir="$(CloneMountDrive):/" />

			<!-- STEP 2c: the Unreal compile, straight off the clone. -->
			<Spawn Exe="cmd.exe" Arguments="/C $(CloneMountDrive):\Engine\Build\BatchFiles\Build.bat $(UETarget) $(UEPlatform) $(UEConfiguration) $(UEProject) $(ExtraUbtArgs)" WorkingDir="$(CloneMountDrive):/" />
		</Node>

		<!-- Step 3: cleanup - SUCCESS FAST PATH ONLY. Guaranteed teardown is
		     registered as a Horde UE_HORDE_CLEANUP lease hook by
		     attach-clone-lun.ps1 and runs regardless of outcome. This node is
		     only the fast path on success; the script is idempotent so running
		     both is fine. -->
		<Node Name="Cleanup Clone" Requires="Compile">
			<Spawn Exe="powershell.exe" Arguments="-NoProfile -ExecutionPolicy Bypass -File Build/teardown-clone-lun.ps1 -Execute -CloneVolumeName &quot;$(CloneVolumeName)&quot; -LunName &quot;$(LunName)&quot; -AgentIgroup &quot;$(AgentIgroup)&quot; -SvmName &quot;$(SvmName)&quot; -FsxAdminIp &quot;$(FsxAdminIp)&quot; -OntapUser &quot;$(OntapUser)&quot; -OntapPasswordSecretName &quot;$(OntapPasswordSecretName)&quot; -AwsRegion &quot;$(AwsRegion)&quot;" />
		</Node>
	</Agent>
</BuildGraph>
