##################################################
# Unreal Horde Build Pipeline — example tfvars
#
# Copy to terraform.tfvars and fill in the REQUIRED values below.
#   cp terraform.tfvars.example terraform.tfvars
#
# NOTE (Epic org access): the default Horde server image is pinned by digest to
# Horde/UE 5.5.0-32559309 for reproducibility:
#   ghcr.io/epicgames/horde-server@sha256:2a3a3009c05d1dcf4ecbed640d2eb4b5eb9ce974df056e011f476aba4cf5c12d
# Pulling it requires membership in the Epic Games GitHub organization. Provide
# github_credentials_secret_arn (below) with credentials that can read it, or
# override horde_server_image with an image you can pull. If you override, the
# custom BuildGraph tasks and the Unreal engine source in Perforce MUST match
# the Horde/UE version of the image you choose.
#
# NOTE (post-deploy P4 password alignment): this sample creates a purpose-built
# Secrets Manager secret with a RANDOM placeholder password for the Horde P4
# user (default "svc-horde"). After the P4 Server is up, align the P4 user's
# password with the secret value, e.g.:
#     p4 -u <super> passwd svc-horde   # set to the value stored in the secret
# Rotating one side without the other breaks Horde's Perforce connection.
##################################################

##################################################
# REQUIRED
##################################################

# Route53 private hosted zone for internal service discovery. Created by this
# sample and associated with the VPC. e.g. "studio.internal"
route53_private_zone_name = "studio.internal"

# Your EXISTING Route53 public hosted zone name. Used for the ACM certificate
# DNS validation and the public Horde record. e.g. "example.com"
route53_public_hosted_zone_name = "example.com"

# The public FQDN for the Horde HTTPS endpoint (the ACM cert domain). Must sit
# under the public hosted zone above. e.g. "horde.example.com"
certificate_domain = "horde.example.com"

# The Perforce stream synced into the FSxN source volume. e.g. "//YourGame/main"
perforce_stream = "//YourGame/main"

##################################################
# OPTIONAL (defaults shown; uncomment to override)
##################################################

# project_prefix = "cgd"
# region         = "us-east-1"
# vpc_cidr       = "10.0.0.0/16"

# --- Perforce ---
# perforce_server_name = "perforce"
# Set to wire agents to an EXISTING P4 server and skip deploying the bundled
# Perforce module (e.g. "ssl:perforce.example.com:1666"):
# existing_perforce_server_endpoint = null

# --- FSx for ONTAP ---
# fsxn_storage_capacity_gb = 1024
# Valid SINGLE_AZ_1 throughput values: 128, 256, 512, 1024, 2048, 4096
# fsxn_throughput_capacity = 128

# --- Horde agents ---
# sync_agent_instance_type  = "c6i.xlarge"   # network-optimized Linux sync pool
# build_agent_instance_type = "c6a.8xlarge"  # compute-optimized Windows build pool
# build_agent_max_count     = 5

# --- Horde server ---
# Pinned by digest to Horde/UE 5.5.0-32559309. Override ONLY with a matching
# Horde/UE version (the custom BuildGraph tasks + engine source in Perforce must
# match), e.g.:
# horde_server_image = "ghcr.io/epicgames/horde-server@sha256:2a3a3009c05d1dcf4ecbed640d2eb4b5eb9ce974df056e011f476aba4cf5c12d"
# ARN of a Secrets Manager secret with GitHub creds to pull Epic's private image
# (set to null if the image does not require authentication):
# github_credentials_secret_arn = null
# NON-SECRET P4 username Horde authenticates as (rendered into globals.json's
# perforceClusters "default" cluster as serviceAccount). MUST match the
# "username" field inside the horde_p4_credentials_secret_arn secret. The
# password is delivered via that secret and is never set here.
# horde_p4_service_account_username = "svc-horde"
# enable_new_agents_by_default = true

# --- External access ---
# Additional operator IPs allowed to reach the Horde web UI (each a specific CIDR; never 0.0.0.0/0).
# additional_allowed_cidrs = ["203.0.113.4/32"]
